# Zenodo access token (required)
ZENODO_TOKEN=your_zenodo_personal_access_token

# Directory where downloaded files will be stored (required)
ZENODO_DOWNLOAD_PATH=./downloads

# Elasticsearch query string to filter records (optional, leave empty for all records)
# Example: "software"  or  "title:climate"  or  "communities:ecfunded"
ZENODO_QUERY=software

# Number of files to download per run (optional, default: 5)
ZENODO_NUM_FILES=5

# Path to the cursor file that tracks the last downloaded record ID
# (optional, default: .zenodo_cursor)
ZENODO_CURSOR_PATH=.zenodo_cursor
